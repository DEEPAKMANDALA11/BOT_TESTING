        "    docs = \", \".join(row['supporting_documents']) if isinstance(row['supporting_documents'], list) else str(row['supporting_documents'])\n",
        "    return (\n",
        "        f\"Claim Amount: {row['claim_amount']}\\n\"\n",
        "        f\"Location: {row['event_location']}\\n\"\n",
        "        f\"Event Description: {row['event_description']}\\n\"\n",
