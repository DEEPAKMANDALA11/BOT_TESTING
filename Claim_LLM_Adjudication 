        "        \"Deductible (₹)\": deductible,\n",
        "        \"Potential Payout (₹)\": potential_payout,\n",
        "        \"Status\": status,\n",
        "    }\n",
        "\n",
        "# Convert DataFrame to a list of dictionaries to iterate over rows correctly\n",
        "calculated_results = [calculate_payout(claim, policy_rules) for claim in adjudicated_claims.to_dict(orient=\"records\")]\n",
        "df_results = pd.DataFrame(calculated_results)\n",
