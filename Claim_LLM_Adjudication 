        "# Candidate categories\n",
        "CATEGORIES = [\"Home\", \"Vehicle\", \"Medical\", \"Life\"]\n",
        "\n",
        "# -------------------------------------------------------------\n",
        "# 1. Zero-Shot Prompt\n",
        "# -------------------------------------------------------------\n",
        "ZERO_SHOT_SYSTEM = f\"\"\"You are an insurance claims triage specialist.\n",
        "Classify the given claim into exactly one of these categories: {\", \".join(CATEGORIES)}.\n",
        "\n",
        "Category Definitions:\n",
