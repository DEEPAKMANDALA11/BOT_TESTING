        "        eligible_loss = 0\n",
        "        potential_payout = 0\n",
        "    else:\n",
        "        eligible_loss = claimed_amt\n",
        "        # Use standard Python built-ins explicitly to bypass PySpark's overridden functions\n",
        "        potential_payout = __builtins__.max(0, __builtins__.min(eligible_loss, coverage_limit) - deductible)\n",
        "\n",
        "    return {\n",
        "        \"Customer\": claim[\"Customer\"],\n",
        "        \"Policy No.\": claim[\"Policy No.\"],\n",
        "        \"Policy Type\": policy_type,\n",
        "        \"Claimed (₹)\": claimed_amt,\n",
        "        \"Eligible Loss (₹)\": eligible_loss,\n",
