        "from pyspark.sql import SparkSession\n",
        "from pyspark.sql.functions import *\n",
        "from pyspark.sql.types import *\n",
        "\n",
        "# Create a Spark session\n",
        "spark = SparkSession.builder \\\n",
        "    .appName(\"InsuranceClaimsValidation\") \\\n",
        "    .getOrCreate()\n",
        "\n",
        "# Read the extracted claims JSON using Spark with multiLine option enabled\n",
        "DF = spark.read.option(\"multiLine\", True).json(\"extracted_claims.json\")\n",
        "\n",
        "# Calculate size of missing mandatory fields\n",
        "DF_with_size = DF.withColumn(\"Size\", size(col(\"missing_mandatory_fields\")))\n",
        "\n",
        "# Filter incomplete and complete claims\n",
        "incomplete_df = DF_with_size.filter(col(\"Size\") > 0)\n",
        "complete_df = DF_with_size.filter(col(\"Size\") == 0)\n",
        "\n",
        "\n",
        "complete_df.show()\n",
        "\n",
        "# Display the results in the console\n",
        "print(\"--- Incomplete Claims ---\")\n",
