        "# ---------------------------------------------------------------\n",
        "def extract_claim(email: str, mode: str = \"auto\", llm: Callable[[str, str], str] = None) -> ClaimExtraction:\n",
        "    \"\"\"mode: 'llm' | 'rules' | 'auto' (LLM if a Groq key exists or llm is given, else rules).\"\"\"\n",
        "    use_llm = mode == \"llm\" or (mode == \"auto\" and (llm is not None or _groq_key()))\n",
        "    if use_llm:\n",
        "        try:\n",
        "            return extract_with_llm(email, llm or groq_llm)\n",
        "        except Exception as e:\n",
        "            if mode == \"llm\":\n",
        "                raise\n",
        "            res = extract_with_rules(email)\n",
        "            return res.model_copy(update={\"notes\": res.notes + [f\"LLM extraction failed ({str(e)[:80]}); rule-based result used.\"]})\n",
        "    return extract_with_rules(email)\n",
