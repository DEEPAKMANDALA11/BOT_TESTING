        "  \"reasoning\": \"<brief 1-sentence rationale>\"\n",
        "}}\n",
        "\"\"\"\n",
        "\n",
        "# -------------------------------------------------------------\n",
        "# 2. Few-Shot Prompt\n",
        "# -------------------------------------------------------------\n",
        "FEW_SHOT_SYSTEM = f\"\"\"You are an insurance claims triage specialist.\n",
        "Classify the given claim into exactly one of these categories: {\", \".join(CATEGORIES)}.\n",
        "\n",
        "Here are representative examples:\n",
