        "  \"reasoning\": \"<brief 1-sentence rationale>\"\n",
        "}}\n",
        "\"\"\"\n",
        "\n",
        "# Use the verified complete claims DataFrame from Spark\n",
        "claims_df = complete_df.toPandas()\n",
